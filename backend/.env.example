# 管理 API 的金鑰：請填一組長的隨機字串，至少 16 個字元（必填，沒填服務會拒絕啟動）
ADMIN_API_KEY=

# Ollama（跑在主機上）
OLLAMA_BASE_URL=http://host.docker.internal:11434
CHAT_MODEL=qwen2.5:7b
EMBED_MODEL=mxbai-embed-large
EMBED_DIM=1024
# 單次呼叫 Ollama 的逾時秒數、回答的最大 token 數、context 長度
LLM_TIMEOUT_SECONDS=120
LLM_NUM_PREDICT=512
LLM_NUM_CTX=8192

# 內部服務（docker-compose 內部網路）
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=documents
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql://chatbot:chatbot@postgres:5432/chatbot

UPLOAD_DIR=/data/uploads
PERSONA_PATH=config/persona.yaml

# 檢索與切段
RETRIEVAL_TOP_K=4
SCORE_THRESHOLD=0.6
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# 對話記憶
SESSION_TTL_SECONDS=3600
HISTORY_MAX_TURNS=6

# 安全與限制（CORS_ORIGINS 以逗號分隔，例如 https://your-site.com）
CORS_ORIGINS=
MAX_UPLOAD_MB=20
MAX_MESSAGE_CHARS=1000
RATE_LIMIT_PER_MINUTE=10
LLM_MAX_CONCURRENCY=1
LLM_QUEUE_TIMEOUT_SECONDS=30
